# DRAFT - copy to the repo root as .gitignore

# ---- Build output (regenerated by ./gradlew) ----
build/
.gradle/
*.apk
*.aab
*.ap_
*.dex
captures/
.externalNativeBuild/
.cxx/

# ---- Local machine / toolchain state ----
# local.properties holds your absolute SDK path; it differs per machine.
local.properties
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.devcontainer/devcontainer.local.json

# ---- Secrets: NEVER commit these ----
# Release signing material. Keep it off the box entirely; supply via CI secret or
# an env var at build time. Debug builds self-generate ~/.android/debug.keystore.
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
signing.properties

# Firebase/Google config. Real one comes from CI secret or a local copy you never add.
google-services.json
GoogleService-Info.plist

# Generic env files
.env
.env.*
!.env.example

# Private keys / service accounts
*.pem
id_rsa*
id_ed25519*
service-account*.json

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
*.log
*.swp
.history/

# ---- Framework-specific, in case you pick one later ----
# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
# Node / React Native / Expo
node_modules/
.expo/
dist/
.npm/
next-env.d.ts